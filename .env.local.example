# ============================================
# NLP Connect — Environment Variables
# Copy this file to .env.local and fill in your keys
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Twilio (UK number recommended for UK/Europe calls) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+44xxxxxxxxxx

# --- Deepgram (Speech-to-Text) ---
DEEPGRAM_API_KEY=your-deepgram-api-key

# --- Google AI / Gemini (LLM Analysis + Sheets API) ---
# This key is used for both Gemini Flash and Google Sheets import
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Optional: separate key for Google Sheets if preferred
# GOOGLE_SHEETS_API_KEY=your-sheets-api-key
